{
  "name": "todoapi",
  "packageManager": "pnpm@10.28.2",
  "volta": {
    "node": "24.13.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "container": "docker-compose up --build -d",
    "generate:prisma": "prisma generate",
    "generate:swagger": "swagger-cli bundle ./swagger/openapi.yaml -o ./swagger/build/openapi.yaml -t yaml -r",
    "generate:swagger-type:api": "openapi-typescript ./swagger/build/openapi.yaml -o ./src/types/openapi.ts",
    "lint": "eslint ./**/*.ts",
    "migrate": "prisma migrate dev --name init",
    "start": "nodemon"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "log4js": "^6.9.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "prisma": "6.19.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.19",
    "@types/eslint": "^9",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.2.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-oauth2": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.3.0",
    "nodemon": "^3.1.11",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
