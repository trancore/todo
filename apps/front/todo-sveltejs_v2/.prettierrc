{
	"importOrder": ["<THIRD_PARTY_MODULES>", "", "^$app/(.*)$", "", "^$lib/(.*)$", "", "^[./]"],
	"importOrderSeparation": true,
	"importOrderParserPlugins": ["typescript"],
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": [
		"prettier-plugin-svelte",
		"prettier-plugin-tailwindcss",
		"@ianvs/prettier-plugin-sort-imports"
	],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"tailwindStylesheet": "./src/lib/assets/css/tailwind.css"
}
